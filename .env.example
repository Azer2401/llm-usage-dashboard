# ============================================================
# LLM Usage Dashboard — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values

PORT=3003
NODE_ENV=development

# ─── AITM Database (PostgreSQL 15, port 5432) ───────────────
AITM_DB_HOST=localhost
AITM_DB_PORT=5432
AITM_DB_NAME=ai_talent_db
AITM_DB_USER=postgres
AITM_DB_PASSWORD=postgres

# Prisma DATABASE_URL (same DB, new llm_* tables)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_talent_db?schema=public"

# ─── GoClaw Database (pgvector, port 5433) ──────────────────
GOCLAW_DB_HOST=localhost
GOCLAW_DB_PORT=5433
GOCLAW_DB_NAME=postgres
GOCLAW_DB_USER=postgres
GOCLAW_DB_PASSWORD=goclaw

# ─── GoClaw API ─────────────────────────────────────────────
GOCLAW_API_URL=http://localhost:18790
GOCLAW_GATEWAY_TOKEN=<goclaw-gateway-token>
GOCLAW_PID=129519
GOCLAW_CONFIG_PATH=/home/devops/apps/config.json

# ─── AITM JWT (same secret as AITM backend) ─────────────────
JWT_SECRET=supersecretjwt

# ─── Internal Service Keys (for N8N / GoClaw internal APIs) ─
INTERNAL_KEY_N8N=<generate-random-key>
INTERNAL_KEY_GOCLAW=<generate-random-key>
INTERNAL_KEY_BACKEND=<generate-random-key>

# ─── Cron Intervals ─────────────────────────────────────────
CRON_THROTTLE_MINUTES=5
CRON_GOCLAW_SYNC_MINUTES=5
CRON_AGGREGATE_HOUR=0

# ─── N8N Scout Default Pricing (USD) ────────────────────────
N8N_SCOUT_COST_PER_HIT=0.251
N8N_SCOUT_APIFY_REQUESTS_PER_HIT=50
N8N_SCOUT_SERPER_QUERIES_PER_HIT=1

# ─── Throttle Defaults ──────────────────────────────────────
DEFAULT_THROTTLE_REQUEST_LIMIT=1
DEFAULT_WARNING_THRESHOLD_PCT=80
